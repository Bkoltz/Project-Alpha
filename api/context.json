{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project Alpha Income Data",
  "description": "Monthly income sample/seed data used by the financial dashboard chart.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "month": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}$",
        "description": "ISO year-month, e.g. 2025-05."
      },
      "income": {
        "type": "number",
        "minimum": 0,
        "description": "Income amount in the configured currency (default USD)."
      }
    },
    "required": ["month", "income"],
    "additionalProperties": false
  }
}
