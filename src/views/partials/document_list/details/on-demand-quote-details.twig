												display: flex
											}
											.print-footer {
												display: none
											}
											@media print {
												.no-print {
													display: none !important
												}
												.side-nav,
												.nav-footer {
													display: none
												}
												.main-content {
													margin-left: 0
												}
												body {
													background: #fff
												}
