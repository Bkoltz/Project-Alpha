<section>
	<div class="doc-type" style="text-align:center;font-weight:700;font-size:22px;margin-bottom:6px">Long-term Service Contract</div>
	<div style="text-align:center;color:#6b7280;margin-bottom:16px;font-size:13px">Recurring Billing Agreement</div>

	<div class="no-print" style="display:flex;gap:8px;margin-bottom:8px">
		<a href="javascript:history.back()" style="padding:6px 10px;border:1px solid #ddd;border-radius:8px;background:#fff; font-size: medium;">Back</a>
		<a href="/?page=contract/long-term-contract-pdf&id={{id}}" target="_blank" rel="noopener" style="padding:6px 10px;border:1px solid #ddd;border-radius:8px;background:#fff; font-size: medium;">View PDF</a>
		<a href="/?page=contract/long-term-contract-pdf&id={{id}}" download="longterm-contract-{{contract.doc_number ?? id}}.pdf" style="padding:6px 10px;border:1px solid #ddd;border-radius:8px;background:#fff; font-size: medium; margin-left:4px;">Download</a>
	</div>

	<table style="width:100%;table-layout:fixed;margin-bottom:8px;border-collapse:collapse">
		<tr>
			<td style="vertical-align:middle;width:70%">
				<div style="font-weight:700;font-size:20px">{{brand}}</div>
				{% if contract.projectCode is defined %}
					<div style="color:#374151;font-size:13px;margin-top:2px">Job
						{{contract.projectCode}}</div>
				{% endif %}

				{% if contract.projectId is defined %}
					<div style="color:#374151;font-size:13px;margin-top:2px">Project
						{{contract.projectId}}</div>
				{% endif %}
			</td>
			<td style="vertical-align:middle;width:30%;text-align:right">
				<img src="{{logoSrc}}" alt="{{brand}}" style="height:80px;width:auto;object-fit:contain;border-radius:4px;background:#fff;padding:4px">
			</td>
		</tr>
	</table>

	<!-- Contract Details Box -->
	<table style="width:100%;table-layout:fixed;margin-bottom:16px;border-collapse:collapse;border:1px solid #e5e7eb;background:#f9fafb">
		<tr>
			<td style="width:25%;padding:8px;border-right:1px solid #e5e7eb;vertical-align:top">
				<div style="font-size:11px;color:#6b7280">Start Date</div>
				<div style="font-weight:600;color:#111">{{startDate}}</div>
			</td>
			<td style="width:25%;padding:8px;border-right:1px solid #e5e7eb;vertical-align:top">
				<div style="font-size:11px;color:#6b7280">End Date</div>
				<div style="font-weight:600;color:#111">{{isOngoing ? 'Ongoing' : contract.endDate}}</div>
			</td>
			<td style="width:25%;padding:8px;border-right:1px solid #e5e7eb;vertical-align:top">
				<div style="font-size:11px;color:#6b7280">Billing Frequency</div>
				<div style="font-weight:600;color:#111"><?php echo htmlspecialchars($billingInterval); ?></div>
			</td>
			<td style="width:25%;padding:8px;vertical-align:top">
				<div style="font-size:11px;color:#6b7280">Status</div>
				<div style="font-weight:600;color:#111;text-transform:capitalize">{{contract.status}}</div>
			</td>
		</tr>
	</table>

	{% if showDepositInfo %}
		<table style="width:100%;table-layout:fixed;margin-bottom:16px;border-collapse:collapse;border:1px solid #a7f3d0;background:#ecfdf5">
			<tr>
				<td style="padding:8px;vertical-align:top">
					<div style="font-size:11px;color:#065f46">Initial Deposit Due:
						<span style="font-weight:700;font-size:14px">${{contract.requiredDeposit}}</span>
					</div>
				</td>
			</tr>
		</table>
	{% endif %}

	<table style="width:100%;table-layout:fixed;margin:12px 0 16px;border-collapse:collapse">
		<tr>
			<td style="vertical-align:top;width:50%;padding-right:12px">
				<div style="font-weight:600">Service Provider</div>

				{% for line in fromLines %}
					<div>{{line}}</div>
				{% endfor %}
			</td>
		</tr>
	</div>
	<div style="margin-top:6px;color:#4b5563;font-size:13px">
		{% if fromPhone is not empty %}
			<div>{{fromPhone}}</div>
		{% endif %}

		{% if fromEmail is not empty %}
			<div>{{fromEmail}}</div>
		{% endif %}
	</div>
	<td style="vertical-align:top;width:50%;padding-left:12px">
		<div style="font-weight:600">Client</div>
		<div>
			{% for line in toLines %}
				<div>{{line}}</div>
			{% endfor %}
		</div>
		<div style="margin-top:6px;color:#4b5563;font-size:13px">
			{% if toPhone is not empty %}
				<div>{{toPhone}}</div>
			{% endif %}

			{% if toEmail is not empty %}
				<div>{{toEmail}}</div>
			{% endif %}
		</div>
	</td>
	{% if contract.scope is defined %}
		<div style="margin:16px 0;padding:12px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px">
			<div style="font-weight:600;margin-bottom:8px">Scope of Work</div>
			<div style="white-space:pre-wrap;font-size:14px;line-height:1.6;color:#374151">{{contract.scope}}</div>
		</div>
	{% endif %}
	<table style="width:100%;border-collapse:collapse;background:#fff;border-radius:8px;box-shadow:0 6px 18px rgba(11,18,32,0.06);margin-top:16px">
		<thead>
			<tr style="text-align:left;border-bottom:1px solid #eee;background:#f9fafb">
				<th colspan="4" style="padding:12px;font-size:15px">{{contract.pricingType == 'per_invoice' ? 'Recurring Amount (per invoice)' : 'Fixed Total (billed over time)'}}</th>
			</tr>
		</thead>
		<tbody>
			{% if contract.pricingType == perInvoice %}
				<tr>
					<td colspan="3" style="padding:12px">Recurring service fee (billed
						{{quote.billingIntervalCount}}
						{{quote.billingIntervalUnit}})</td>
					<td style="padding:12px;text-align:right;font-weight:600">${{contract.pricePerInvoice}}</td>
				</tr>
			{% else %}
				{% if items is defined %}
					<tr style="border-bottom:1px solid #eee">
						<th style="padding:10px">Description</th>
						<th style="padding:10px">Qty</th>
						<th style="padding:10px">Unit</th>
						<th style="padding:10px">Line Total</th>
					</tr>
					{% for item in items %}
						<tr style="border-top:1px solid #f3f4f6">
							<td style="padding:10px">{{item.item}}</td>
							<td style="padding:10px">{{item.description}}</td>
							<td style="padding:10px">{{item.quantity}}</td>
							<td style="padding:10px">${{item.unitPrice}}</td>
							<td style="padding:10px">${{item.lineTotal}}</td>
						</tr>
					{% endfor %}
				{% endif %}
				<tr>
					<td style="padding:10px;font-weight:600">Subtotal</td>
					<td style="padding:10px">${{contract.subtotal}}</td>
				</tr>
				<tr>
					<td style="padding:10px;font-weight:600">Discount</td>
					<td style="padding:10px">
						{% if contract.discountType = 'percent' %}
							{{contract.discountValue}}%
						{% elseif contract.discountType = 'fixed' %}
							${{contract.discountValue}}
						{% else %}
							$0.00
						{% endif %}
					</td>
				</tr>
				<tr>
					<td style="padding:10px;font-weight:600">Tax</td>
					<td style="padding:10px">{% contract.taxPercent %}%</td>
				</tr>
				{% if contract.isOngoing %}
					<tr>
						<td style="padding:10px;font-weight:700">Contract Total</td>
						<td style="padding:10px;font-weight:700">${{contract.total}}</td>
					</tr>
				{% endif %}
			{% endif %}
			<tr style="background:#ecfdf5;border-top:2px solid #10b981">
				<td colspan="3" style="padding:12px;font-weight:700;font-size:15px;color:#065f46">Amount Per Invoice</td>
				<td style="padding:12px;font-weight:700;font-size:16px;color:#065f46;text-align:right">${{contract.invoiceAmount}}</td>
			</tr>
			<tr>
				<td colspan="4" style="border-top:1px solid #eee"></td>
			</tr>
			<tr>
				<td colspan="4" style="padding:12px 10px;color:#374151;font-size:13px;line-height:1.4">
					<strong>By signing below</strong>, I acknowledge that this is a multi-page contract and that I have read and agree to the recurring billing terms and conditions.</td>
			</tr>
			<tr>
				<td colspan="4" style="padding:20px 10px 40px">
					<div style="border-top:2px solid #111;width:50%;margin-top:40px"></div>
					<div style="margin-top:4px;color:#4b5563">Client Signature</div>
				</td>
			</tr>
		</tbody>
	</table>
	<div style="page-break-after:always"></div>
	<h3>Terms and Conditions</h3>
	{% if contract.terms is not defined  %}
		<div style="white-space:pre-wrap;padding:6px 0;font-family: Georgia, 'Times New Roman', serif; font-size:13px; line-height:1.6; color:#222;">{{contract.terms}}</div>
	{% else %}
		<ul>
			<li>This is a recurring billing agreement. Invoices will be generated automatically every{{quote.billingIntervalCount}}
				{{quote.billingIntervalUnit}}.</li>
			<li>Contract begins on{{contract.startDate}}and{{contract.isOngoing ? 'continues until terminated by either party' : 'ends on ' ~ contract.endDate}}.</li>
			<li>Payment due NET 30 unless otherwise specified.</li>
			<li>Termination requires written notice.</li>
			<li>Work product ownership and usage rights per agreement.</li>
		</ul>
	{% endif %}
</section>
