<thead>
	<tr style="text-align:left;border-bottom:1px solid #eee">
		<th style="padding:10px">No.</th>
		<th style="padding:10px">Project</th>
		<th style="padding:10px">Client</th>
		<th style="padding:10px">Status</th>
		<th style="padding:10px">Start Date</th>
		<th style="padding:10px">Billing</th>
		<th style="padding:10px">Amount Per</th>
		<th style="padding:10px">Created</th>
		<th style="padding:10px">Actions</th>
	</tr>
</thead>

<tbody>
	{% for row in rows %}
		{% set statusColors = {
			'pending': '#fffbeb',
			'approved': '#ecfdf5',
			'rejected': '#fef2f2'
		} %}
		<tr style="border-top:1px solid #f3f4f6;background:{{ statusColors[row.status] ?? '#fff' }};">
			<td style="padding:10px">LQ-{{row.doc_number}}</td>
			<td style="padding:10px">{{row.project_code}}</td>
			<td style="padding:10px">
				<a href="/?page=client/clients-list&selected_client_id={{row.client_id}}; ?>">{{row.client_name}}</a>
			</td>
			<td style="padding:10px;text-transform:capitalize">{{row.status}}</td>
			<td style="padding:10px">{{row.start_date}}</td>
			<td style="padding:10px">{{row.billing_interval_count}} {{row.billing_interval_unit}}</td>
			<td style="padding:10px">${{row.total}}</td>
			<td style="padding:10px">{{row.created_at}}</td>
			<td style="padding:10px;display:flex;gap:8px">
				<a href="/?page=quote/quote-details&id={{row.id}}" style="padding:6px 10px;border:1px solid #ddd;border-radius:8px;background:#fff; font-size: small;">View</a>

				{% if row.status == 'pending' %}
					<a href="/?page=quote/quote-edit&id={{row.id}}" style="padding:6px 10px;border:1px solid #ddd;border-radius:8px;background:#fff; font-size: small;">Edit</a>
				{% endif %}

				{% if row.status !== 'rejected' %}
					<form method="post" action="/?page=quote/email-send" style="display:inline">
						<input type="hidden" name="type" value="long_term_quote">
						<input type="hidden" name="id" value="{{row.id}}">
						<button type="submit" style="padding:6px 10px;border:1px solid #ddd;border-radius:8px;background:#fff; font-size: small;">Email</button>
					</form>
				{% endif %}

				{% if row.status == 'pending' %}
					<form method="post" action="/?page=quote/quote-approve" onsubmit="return confirm('Approve this long-term quote and generate long-term contract?')">
						<input type="hidden" name="id" value="{{row.id}}">
						<button type="submit" style="padding:6px 10px;border:0;border-radius:8px;background:#16a34a;color:#fff; font-size: small;">Approve</button>
					</form>

					<form method="post" action="/?page=quote/quote-reject" onsubmit="return confirm('Deny this quote?')">
						<input type="hidden" name="id" value="{{row.id}}">
						<button type="submit" style="padding:6px 10px;border:0;border-radius:8px;background:#ef4444;color:#fff; font-size: small;">Deny</button>
					</form>
				{% endif %}

			</td>
		</tr>
	{% endfor %}
</tbody>
