<thead>
	<tr style="text-align:left;border-bottom:1px solid #eee">
		<th style="padding:10px">No.</th>
		<th style="padding:10px">Contract</th>
		<th style="padding:10px">Project</th>
		<th style="padding:10px">Client</th>
		<th style="padding:10px">Total</th>
		<th style="padding:10px">Status</th>
		<th style="padding:10px">Due Date</th>
		<th style="padding:10px">Created</th>
		<th style="padding:10px">Actions</th>
	</tr>
</thead>

<tbody>
	{% for row in rows %}
		{% set statusColors = {
			'draft': '#f9fafb',
			'sent': '#fffbeb',
			'paid': '#ecfdf5',
			'overdue': '#fef2f2',
			'cancelled': '#fef2f2'
		} %}
		<tr style="border-top:1px solid #f3f4f6;background:{{ statusColors[row.status] ?? '#fff' }};">
			<td style="padding:10px">
				<a href="/?page=invoice/invoice-details&id=" style="text-decoration:none;color:inherit">ODI-{{row.doc_number}}</a>
			</td>
			<td style="padding:10px">
				<a href="/?page=contract/on-demand-contracts-list" style="text-decoration:none;color:inherit">ODC-{{row.contract.doc_number}}</a>
			</td>
			<td style="padding:10px">{{row.project_code}}</td>
			<td style="padding:10px">
				<a href="/?page=client/clients-list&selected_client_id=<?php echo (int)$r['client_id']; ?>">{{row.client}}</a>
			</td>
			<td style="padding:10px">${{row.total}}</td>
			<td style="padding:10px;text-transform:capitalize">{{row.status}}</td>
			<td style="padding:10px">{{row.end_date}}</td>
			<td style="padding:10px">{{row.created_at}}</td>
			<td style="padding:10px;display:flex;flex-wrap:wrap;gap:8px;align-items:center">
				<a href="/?page=invoice/invoice-details&id={{id}}" style="padding:6px 10px;border:1px solid #ddd;border-radius:8px;background:#fff; font-size: small;">View</a>
                
				{% if row.status != 'void' and row.status != 'paid' %}
					<form method="post" action="/?page=email-send" style="display:inline">
						<input type="hidden" name="csrf" value="{{token}}">
						<input type="hidden" name="type" value="invoice">
						<input type="hidden" name="id" value="{{row.id}}">
						<input type="hidden" name="redirect_to" value="{{request_uri}}">
						<button type="submit" style="padding:6px 10px;border:1px solid #ddd;border-radius:8px;background:#fff; font-size: small;">Email</button>
					</form>
				{% endif %}
			</td>
		</tr>
	{% endfor %}
</tbody>
