<thead>
	<tr style="text-align:left;border-bottom:1px solid #eee">
		<th style="padding:10px">No.</th>
		<th style="padding:10px">Project</th>
		<th style="padding:10px">Client</th>
		<th style="padding:10px">Total</th>
		<th style="padding:10px">Status</th>
		<th style="padding:10px">Created</th>
		<th style="padding:10px">Due</th>
		<th style="padding:10px">Actions</th>
		<th style="padding:10px">Edit</th>
	</tr>
</thead>
<tbody>
	{% for row in rows %}
		{% set statusColors = {
			'unpaid': '#fffbeb',
			'partial': '#fff7ed',
			'paid': '#ecfdf5',
			'void': '#fef2f2',
			'denied': '#fef2f2'
		} %}
		<tr style="border-top:1px solid #f3f4f6;background:{{ statusColors[row.status] ?? '#fff' }};">
			<td style="padding:10px">I-{{row.doc_number}}</td>
			<td style="padding:10px">{{row.project_code}}</td>
			<td style="padding:10px">
				<a href="/?page=client/clients-list&selected_client_id={{row.client_id}}">{{row.client_name}}</a>
			</td>
			<td style="padding:10px">${{row.total}}</td>
			<td style="padding:10px;text-transform:capitalize">{{row.status}}</td>
			<td style="padding:10px">{{row.created_at}}</td>
			<td style="padding:10px">{{row.due_date}}</td>
			<td style="padding:10px">
				<a href="/?page=invoice/invoice-details&id={{row.id}}" style="padding:6px 10px;border:1px solid #ddd;border-radius:8px;background:#fff;margin-right:6px; font-size: small;">View</a>

				{% if row.status != 'void' %}
					<form method="post" action="/?page=email-send" style="display:inline;margin-right:6px">
						<input type="hidden" name="csrf" value="{{token}}">
						<input type="hidden" name="type" value="invoice">
						<input type="hidden" name="id" value="{{row.id}}">
						<input type="hidden" name="redirect_to" value="{{request_uri}}">
						<button type="submit" style="padding:6px 10px;border:1px solid #ddd;border-radius:8px;background:#fff; font-size: small;">Email</button>
					</form>
				{% endif %}

				{% if row.status != 'paid' and row.status != 'void' %}
					<form method="post" action="/?page=invoice/invoices-mark-paid" onsubmit="return confirm('Mark invoice paid?')" style="display:inline">
						<input type="hidden" name="id" value="{{row.id}}">
						<button type="submit" style="padding:6px 10px;border:0;border-radius:8px;background:#d1fae5;color:#065f46; font-size: small;">Paid</button>
					</form>
				{% endif %}
			</td>
			<td style="padding:10px">
				{% if row.status != 'paid' %}
					<a href="/?page=invoice/invoices-edit&id={{row.id}}" style="padding:6px 10px;border:1px solid #ddd;border-radius:8px;background:#fff; font-size: small;">Edit</a>
				{% else %}
					<span style="color:#9ca3af;font-size:small">—</span>
				{% endif %}
			</td>
		</tr>
	{% endfor %}
</tbody>
