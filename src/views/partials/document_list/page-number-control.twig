<div style="margin-top:12px;display:flex;justify-content:space-between;align-items:center">
	<div>
		<form method="get" action="/">
			<input type="hidden" name="page" value="quote/quote-list">
			<label>Per page
				<select name="per_page" onchange="this.form.submit()" style="padding:6px;border-radius:8px;border:1px solid #ddd">
					<option value="50">50</option>
					<option value="100">100</option>
				</select>
			</label>
		</form>
	</div>

	{# Page buttons #}
	<div style="display:flex;gap:8px">
		{% if page > 1 %}
			<a href="{{previous_page_path}}" style="padding:6px 10px;border:1px solid #ddd;border-radius:8px;background:#fff">Prev</a>
		{% endif %}
		<div style="padding:6px 10px;color:var(--muted)">Page
			{{page}}
			/
			{{page_count ?? 1}}
		</div>
		{% if page < page_count %}
			<a href="{{next_page_path}}" style="padding:6px 10px;border:1px solid #ddd;border-radius:8px;background:#fff">Next</a>
		{% endif %}
	</div>
</div>
