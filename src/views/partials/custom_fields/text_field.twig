<textarea type="date" 
    name="{{ field.field_name ?? field.field_key }}" 
    id="{{field.field_key}}{{idSuffix}}" 
    rows="3" 
    style="width:100%;padding:10px;border-radius:8px;border:1px solid #ddd;resize:vertical"
    {% if (field.is_required) %}
        'required '
    {% endif %}
>  </textarea>