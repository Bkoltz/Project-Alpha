{% if app_config.scope_enabled %}
<label>
	<div>Scope of Work</div>
	<textarea name="scope" rows="4" style="width:100%;padding:10px;border-radius:8px;border:1px solid #ddd" placeholder="Optional: Describe the scope of work and deliverables for this contract...">{{document.scope}}</textarea>
</label>
{% endif %}