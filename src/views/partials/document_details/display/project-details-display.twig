<table style="width:100%;table-layout:fixed;margin-bottom:8px;border-collapse:collapse">
	<tr>
		<td style="vertical-align:middle;width:70%">
			<div style="font-weight:700;font-size:20px">{{branding.name}}</div>

			{% if document.project_code is not empty %}
				<div style="color:#374151;font-size:13px;margin-top:2px">Job
					{{document.project_code}}</div>
			{% endif %}

			{% if document.project_id is not empty %}
				<div style="color:#374151;font-size:13px;margin-top:2px">Project
					{{document.project_id}}</div>
			{% endif %}
		</td>

		<td style="vertical-align:middle;width:30%;text-align:right">
			<img src="{{branding.logo_path}}" alt="{{branding.name}}" style="height:80px;width:auto;object-fit:contain;border-radius:4px;background:#fff;padding:4px">
		</td>
	</tr>
</table>
