<section>
	<h2>
		Edit Invoice I-{{invoice.doc_number}}

		{% if invoice.project_code is defined %}
			Job
			{{invoice.project_code}}
		{% endif %}
	</h2>

	<form id="invEditForm" method="post" action="/?page=invoices-update" style="display:grid;gap:16px;max-width:900px">
		<input type="hidden" name="csrf" value="{{token}}">
		<input type="hidden" name="id" value="{{id}}">
		<div style="display:grid;gap:12px;grid-template-columns:1fr 1fr 1fr">

			{% include 'partials/client_componenets/client-input-autocomplete.twig' with {} %}

			<label>
				<div>Due Date</div>
				<input type="date" name="due_date" value="{{inovice.due_date}}" style="width:100%;padding:10px;border-radius:8px;border:1px solid #ddd">
			</label>
			<label>
				<div>Tax (%)</div>
				<input id="taxPercentInv" type="number" step="0.01" name="tax_percent" value="{{inovice.tax_percent}}" style="width:100%;padding:10px;border-radius:8px;border:1px solid #ddd">
			</label>

			{% include 'partials/document_details/input/discount-input.twig' %}

			<label>
				<div>Fulfillment Date</div>
				<input type="date" name="fulfillment_date" value="{{invoice.fulfillment_date}}" style="width:100%;padding:10px;border-radius:8px;border:1px solid #ddd">
			</label>
		</div>

		{# Custom fields #}
		<div id="customFieldsContainer">
			{% include "partials/documnet_details/input/custom-field-input.twig" with {} %}
		</div>

		<div>
			<div style="font-weight:600;margin-bottom:8px">Items (from contract - read only)</div>
			<div style="background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:12px">
				{% if items is defined %}
					<p style="color:#6b7280;margin:0">No items</p>
				{% else %}
					{% include 'partials/doucment_details/display/item-display.twig' with {items: items} %}
				{% endif %}
			</div>
			<p style="color:#6b7280;font-size:0.875rem;margin-top:8px">To change items, modify the contract and apply a discount if needed.</p>
		</div>

		<div>
			<div style="font-weight:600;margin-bottom:8px">Extra Charges (editable)</div>
			<div style="background:#fffbeb;border:1px solid #fbbf24;border-radius:8px;padding:12px;margin-bottom:8px">
				{% if invoice.extra_charges is not defined %}
					<p style="color:#92400e;margin:0">No extra charges added yet. Use the form below to add additional line items.</p>
				{% else %}
					<div id="extraChargesContainer" style="display:grid;gap:8px">
						{% for item in invoice.extra_charges %}
							<div style="display:grid;grid-template-columns:3fr 3fr 1fr 1fr auto;gap:8px;padding:8px;background:#fff;border-radius:4px;border:1px solid #fcd34d">
								<input id="item" type="text" name="extra_item[]" value="{{item.item}}" placeholder="Item name..." style="padding:8px;border-radius:4px;border:1px solid #ddd" data-item-autocomplete data-description-field="extra_desc_<?php echo $idx; ?>" data-price-field="extra_price_<?php echo $idx; ?>">
								<textarea id="description" name="extra_desc[]" placeholder="Description (optional)" style="padding:8px;border-radius:4px;border:1px solid #ddd;resize:vertical;min-height:34px">{{item.description}}</textarea>
								<input id="quantity" type="number" step="0.01" min="0" name="extra_qty[]" value="{{item.quantity}}" placeholder="Quantity" style="padding:8px;border-radius:4px;border:1px solid #ddd">
								<input id="price" type="number" step="0.01" min="0" name="extra_price[]" value="{{item.unit_price}}" placeholder="Price" style="padding:8px;border-radius:4px;border:1px solid #ddd">
								<input type="hidden" name="extra_id[]" value="{{item.id}}">
								<button id="confirm" type="button" onclick="" style="border:0;background:#fee2e2;color:#991b1b;border-radius:4px;padding:8px 10px;cursor:pointer">Remove</button>
							</div>
						{% endfor %}
					</div>
				{% endif %}
			</div>
			<button id="addExtraChargeBtn" type="button" onclick="addExtraCharge()" style="margin-bottom:12px;padding:8px 12px;border-radius:8px;border:1px solid #fbbf24;background:#fffbeb;color:#92400e;cursor:pointer;font-weight:600">+ Add Extra Charge</button>
		</div>

		{% include 'partials/document_details/input/notes-input.twig' with {document: invoice} %}

		{% include 'partials/document_detials/display/scope-display.twig' with {document: invoice} %}
		<p style="color:#6b7280;font-size:0.875rem;margin-top:8px">To modify scope, modify the contract.</p>

		<div>
			<button type="submit" style="padding:10px 14px;border-radius:8px;border:0;background:var(--nav-accent);color:#fff;font-weight:600">Update Invoice</button>
		</div>
	</form>
</section>

<script src="js/invoices-edit-logic.js" defer></script>
