<section>
	<h2>Quotes</h2>
	{# <?php if (!empty($_GET['emailed'])): ?>
													<div style="margin:10px 0;padding:10px 12px;border-radius:8px;background:#ecfdf5;color:#065f46;border:1px solid #a7f3d0">Email sent.</div>
												<?php elseif (!empty($_GET['email_err'])): ?>
													<div style="margin:10px 0;padding:10px 12px;border-radius:8px;background:#fff1f2;color:#881337;border:1px solid #fca5a5">Email failed:
														<?php echo htmlspecialchars($_GET['email_err']); ?></div>
													<?php endif; ?> #}

	{% include 'templates/components/document-filter.html.twig' with filterConfig %}

	<div style="overflow:auto">
		<table style="width:100%;border-collapse:collapse;background:#fff;border-radius:8px;box-shadow:0 6px 18px rgba(11,18,32,0.06)">
			<thead>
				<tr style="text-align:left;border-bottom:1px solid #eee">
					<th style="padding:10px">
                        {{hasDocument ? 'No.' : 'ID'}}
					</th>
					{% if hasProject %}
						<th style="padding:10px">Project</th>
					{% endif %}
					<th style="padding:10px">Client</th>
					<th style="padding:10px">Status</th>
					<th style="padding:10px">Total</th>
					<th style="padding:10px">Created</th>
					<th style="padding:10px;text-align:right">Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for row in rows %}
					<tr style="border-top:1px solid #f3f4f6;{{row.style}}">
						<td style="padding:10px">Q-{{row.doc_number}}</td>
						{% if hasProject %}
							<td style="padding:10px">
								{{row.project_code}}
							</td>
						{% endif %}
						<td style="padding:10px">
							<a href="/?page=client/clients-list&selected_client_id={{row.client_id}} ?>">{{row.client}}</a>
						</td>
						<td style="padding:10px;text-transform:capitalize">{{row.status}}</td>
						<td style="padding:10px">${{row.total}}</td>
						<td style="padding:10px">{{row.created_at}}</td>
						<td style="padding:10px">
							<div style="display:flex;gap:6px;justify-content:flex-end">
								<a href="/?page=quote/quotes-details&id={{row.id}}" style="padding:6px 10px;border:1px solid #ddd;border-radius:8px;background:#fff; font-size: small;">View</a>

								{% if row.status == 'pending' %}
									<a href="/?page=quote/quotes-edit&id={{row.id}}" style="padding:6px 10px;border:1px solid #ddd;border-radius:8px;background:#fff; font-size: small;">Edit</a>
								{% endif %}

								{% if row.status == 'rejected' %}
									<form method="post" action="/?page=quote/email-send" style="display:inline">
										<input type="hidden" name="csrf" value="{{token}}">
										<input type="hidden" name="type" value="quote">
										<input
										type="hidden" name="id" value="{{row['id']}}">
										{# <input type="hidden" name="redirect_to" value="<?php echo htmlspecialchars($_SERVER['REQUEST_URI']); ?>"> #}
										<button type="submit" style="padding:6px 10px;border:1px solid #ddd;border-radius:8px;background:#fff; font-size: small;">Email</button>
									</form>
								{% endif %}

								{% if row.status == 'pending' %}
									<form method="post" action="/?page=quote/quote-approve" onsubmit="return confirm('Approve this quote and generate contract + invoice?')">
										<input type="hidden" name="id" value="{{row.id}}">
										<button type="submit" style="padding:6px 10px;border:0;border-radius:8px;background:#16a34a;color:#fff; font-size: small;">Approve</button>
									</form>
									<form method="post" action="/?page=quote/quote-reject" onsubmit="return confirm('Deny this quote?')">
										<input type="hidden" name="id" value="{{row.id}}">
										<button type="submit" style="padding:6px 10px;border:0;border-radius:8px;background:#ef4444;color:#fff; font-size: small;">Deny</button>
									</form>
								{% endif %}

							</div>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>

	<div style="margin-top:12px;display:flex;justify-content:space-between;align-items:center">
		<div>
			<form method="get" action="/">
				{# {% for pageValues as value %}
					<input type="hidden" name="{{value.key}}" value="{{value.value}}">
				{% endfor %} #}

				<input type="hidden" name="page" value="quote/quotes-list">
				<label>Per page
					<select name="per_page" onchange="this.form.submit()" style="padding:6px;border-radius:8px;border:1px solid #ddd">
						<option value="50">50</option>
						<option value="100">100</option>
					</select>
				</label>
			</form>
		</div>

		{# Page buttons #}
		<div style="display:flex;gap:8px">
			{% if page > 1 %}
				<a href="{{previousPagePath}}" style="padding:6px 10px;border:1px solid #ddd;border-radius:8px;background:#fff">Prev</a>
			{% endif %}
			<div style="padding:6px 10px;color:var(--muted)">Page
				{{page}}/{{pageCount}}
			</div>
			{% if page < pageCount %}
				<a href="{{nextPagePath}}" style="padding:6px 10px;border:1px solid #ddd;border-radius:8px;background:#fff">Next</a>
			{% endif %}
		</div>
	</div>
</section>
