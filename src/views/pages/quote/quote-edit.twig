<section>
	<h2>Edit Quote Q-{{quote.doc_number ?? quote.id}}
		{% if quote.project_code is defined %}
			Job
			{{quote.project_code}}
		{% endif %}
	</h2>
	<form id="quoteEditForm" method="post" action="/?page=quote/quote-edit" style="display:grid;gap:16px;max-width:900px">
		<input type="hidden" name="csrf" value="{{token}}">
		<input type="hidden" name="id" value="{{quote.id}}">

		<div style="display:grid;gap:12px;grid-template-columns:1fr 1fr">
			{% include 'partials/client_components/client-input-autocomplete.twig' with {document: quote} %}

			<label>
				<div>Tax (%)</div>
				<input id="taxPercent" type="number" step="0.01" name="tax_percent" value="{{quote.tax_percent}}" style="width:100%;padding:10px;border-radius:8px;border:1px solid #ddd">
			</label>

			<label>
				<div>Discount Type</div>
				<select id="discountType" name="discount_type" style="width:100%;padding:10px;border-radius:8px;border:1px solid #ddd">
					<option value="none" {{ quote.discount_type == 'none' ? 'selected' : '' }}>None</option>
					<option value="percent" {{ quote.discount_type == 'percent' ? 'selected' : '' }}>Percent</option>
					<option value="fixed" {{ quote.discount_type == 'fixed' ? 'selected' : '' }}>Fixed $</option>
				</select>
			</label>

			<label>
				<div>Discount Value</div>
				<input id="discountValue" type="number" step="0.01" name="discount_value" value="{{quote.discount_value}}" style="width:100%;padding:10px;border-radius:8px;border:1px solid #ddd">
			</label>

			<label>
				<div>Deposit Type</div>
				<select id="depositType" name="deposit_type" style="width:100%;padding:10px;border-radius:8px;border:1px solid #ddd">
					<option value="none" {{ quote.deposit_type == 'none' ? 'selected' : '' }}>None</option>
					<option value="percent" {{ quote.deposit_type == 'percent' ? 'selected' : '' }}>Percent</option>
					<option value="fixed" {{ quote.deposit_type == 'fixed' ? 'selected' : '' }}>Fixed $</option>
				</select>
			</label>

			<label>
				<div>Deposit Value</div>
				<input id="depositValue" type="number" placeholder=="0" step="0.01" name="deposit_value" value="{{quote.deposit_value}}" style="width:100%;padding:10px;border-radius:8px;border:1px solid #ddd">
			</label>
		</div>

		{% include "partials/document_details/input/custom-field-input.twig" with custom_fields %}

		{% include 'partials/document_details/input/item-input.twig' with {items: items} %}

		{% include 'partials/document_details/input/scope-input.twig' with {app_config: app_config, document: quote} %}

		{% include 'partials/document_details/input/notes-input.twig' with {document: quote} %}

		{% include 'partials/document_details/input/terms-input.twig' with {document: quote} %}

		{% include 'partials/document_details/input/total-input.twig' with {document: quote} %}

		<button type="submit" style="padding:10px 14px;border-radius:8px;border:0;background:var(--nav-accent);color:#fff;font-weight:600">Update Quote</button>
	</form>
</section>

<script src="js/quotes-edit-logic.js" defer></script>
