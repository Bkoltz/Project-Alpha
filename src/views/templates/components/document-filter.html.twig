{#
  Reusable Document List Filter Component (Twig)
  
  Parameters:
  - page: The current page (used for form action)
  - filters: Array of filter configurations, each with:
    - type: 'text', 'date', 'select', 'number', 'client_autocomplete'
    - label: Display label
    - name: Form input name
    - value: Current value
    - id_value: For client_autocomplete, the client ID value
    - options: For select type, array of [{value: '', label: 'All'}, ...]
    - placeholder: Optional placeholder text
    - step: For number inputs, the step value
  - columns: Optional number of grid columns (defaults to filter count + 2)
#}

{% set gridCols = columns|default(filters|length + 2) %}
{% set instanceId = 'filter_' ~ (page|replace({'/' : '_'}))|slice(0, 8) %}

<form method="get" action="/" class="filter-form" style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;max-width:100%">
    <input type="hidden" name="page" value="{{ page }}">
    
    {% for filterName, config in filters %}
        {% set type = config.type|default('text') %}
        {% set label = config.label|default(filterName|capitalize) %}
        {% set value = config.value|default('') %}
        {% set idValue = config.id_value|default(0) %}
        
        <div style="display:flex;flex-direction:column;gap:4px;min-width:0;flex:0 1 150px;max-width:180px">
            <label for="{{ instanceId }}_{{ filterName }}" style="font-size:13px;font-weight:600;color:#374151">
                {{ label }}
            </label>
            
            {% if type == 'text' %}
                <input 
                    type="text" 
                    id="{{ instanceId }}_{{ filterName }}"
                    name="{{ filterName }}" 
                    value="{{ value }}"
                    placeholder="{{ config.placeholder|default('') }}"
                    style="padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;background:#fff;min-width:0;width:100%;min-height:38px"
                >
            
            {% elseif type == 'date' %}
                <input 
                    type="date" 
                    id="{{ instanceId }}_{{ filterName }}"
                    name="{{ filterName }}" 
                    value="{{ value }}"
                    style="padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;background:#fff;min-width:0;width:100%;min-height:38px"
                >
            
            {% elseif type == 'number' %}
                <input 
                    type="number" 
                    id="{{ instanceId }}_{{ filterName }}"
                    name="{{ filterName }}" 
                    value="{{ value }}"
                    placeholder="{{ config.placeholder|default('') }}"
                    step="{{ config.step|default('1') }}"
                    style="padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;background:#fff;min-width:0;width:100%;min-height:38px"
                >
            
            {% elseif type == 'select' %}
                <select 
                    id="{{ instanceId }}_{{ filterName }}"
                    name="{{ filterName }}"
                    style="padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;background:#fff;min-width:0;width:100%;min-height:38px"
                >
                    {% if config.options %}
                        {% for option in config.options %}
                            <option value="{{ option.value|default('') }}" {% if option.value|default('') == value %}selected{% endif %}>
                                {{ option.label }}
                            </option>
                        {% endfor %}
                    {% endif %}
                </select>
            
            {% elseif type == 'client_autocomplete' %}
                <input 
                    type="hidden" 
                    id="{{ instanceId }}_{{ filterName }}_id"
                    name="{{ filterName }}_id"
                    value="{{ idValue }}"
                >
                <input 
                    type="text" 
                    id="{{ instanceId }}_{{ filterName }}"
                    name="{{ filterName }}"
                    value="{{ value }}"
                    placeholder="{{ config.placeholder|default('Search client...') }}"
                    style="padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;background:#fff;position:relative;z-index:1;min-width:0;width:100%;min-height:38px"
                    data-autocomplete="client"
                    data-hidden-id="{{ instanceId }}_{{ filterName }}_id"
                >
                <div id="{{ instanceId }}_{{ filterName }}_suggestions" style="position:absolute;display:none;background:#fff;border:1px solid #ddd;border-radius:6px;max-height:200px;overflow-y:auto;width:100%;z-index:10;margin-top:-4px"></div>
            {% endif %}
        </div>
    {% endfor %}
    
    {# Submit and Reset buttons #}
    <div style="display:flex;flex-direction:column;gap:4px;flex:0 1 100px;max-width:120px">
        <label style="font-size:13px;font-weight:600;color:#374151;height:24px"></label>
        <button 
            type="submit" 
            style="padding:8px 14px;background:#2563eb;color:#fff;border:0;border-radius:6px;font-weight:600;cursor:pointer;font-size:13px;min-height:38px"
        >
            Filter
        </button>
    </div>
    
    <div style="display:flex;flex-direction:column;gap:4px;flex:0 1 100px;max-width:120px">
        <label style="font-size:13px;font-weight:600;color:#374151;height:24px"></label>
        <a 
            href="/?page={{ page }}" 
            style="padding:8px 14px;background:#f3f4f6;color:#374151;border:1px solid #d1d5db;border-radius:6px;font-weight:600;cursor:pointer;font-size:13px;text-decoration:none;text-align:center;display:inline-block;min-height:38px;box-sizing:border-box"
        >
            Reset
        </a>
    </div>
</form>

<script>
// Client autocomplete functionality
document.querySelectorAll('[data-autocomplete="client"]').forEach(input => {
    const hiddenId = input.getAttribute('data-hidden-id');
    const suggestionsDiv = document.getElementById(input.id + '_suggestions');
    
    // Fetch clients on input
    input.addEventListener('input', function() {
        const query = this.value.trim();
        if (query.length < 2) {
            suggestionsDiv.style.display = 'none';
            return;
        }
        
        fetch('/?page=clients-search&term=' + encodeURIComponent(query))
            .then(r => r.json())
            .then(list => {
                if (!Array.isArray(list) || list.length === 0) {
                    suggestionsDiv.style.display = 'none';
                    return;
                }
                suggestionsDiv.innerHTML = list.map(x => 
                    `<div data-id="${x.id}" data-name="${x.name}" style="padding:8px 10px;cursor:pointer;border-bottom:1px solid #f3f4f6">${x.name}</div>`
                ).join('');
                Array.from(suggestionsDiv.children).forEach(el => {
                    el.addEventListener('click', function() {
                        input.value = this.dataset.name;
                        document.getElementById(hiddenId).value = this.dataset.id;
                        suggestionsDiv.style.display = 'none';
                    });
                });
                suggestionsDiv.style.display = 'block';
            })
            .catch(() => {
                suggestionsDiv.style.display = 'none';
            });
    });
    
    input.addEventListener('blur', function() {
        setTimeout(() => {
            suggestionsDiv.style.display = 'none';
        }, 200);
    });
});
</script>
