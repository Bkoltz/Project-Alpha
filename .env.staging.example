# Project Alpha Staging Environment
# Copy this to .env.staging and fill in real values
# DO NOT commit .env.staging (it is gitignored)

MYSQL_ROOT_PASSWORD=change...r_crypt_strong()
MYSQL_DATABASE=project_alpha_staging
MYSQL_USER=appuser
MYSQL_PASSWORD=change...p_password_here
ADMIN_PASSWORD=change...d_password_here
APP_ENCRYPTION_KEY=change...enerate_with_openssl_rand_hex_32()
APP_AUTH_DISABLED=false

# === Stripe TEST keys ONLY on staging (never live keys) ===
stripe_publishable_key=pk_test_your_publishable_key_here
stripe_secret_key_enc=plain::sk_tes...here
# Get this from Stripe Dashboard → Developers → Webhooks → Signing secret
stripe_webhook_secret_enc=plain::whsec_your_webhook_secret_here

# === Surcharge ===
stripe_surcharge_percent=2.9
stripe_surcharge_fixed=0.30
stripe_surcharge_split_percent=50
stripe_surcharge_type=split
stripe_surcharge_message="Using a credit card is a privilege for both parties, so it is fair that we split the fee"
