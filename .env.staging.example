# Project Alpha Staging Environment
# Copy this to .env.staging and fill in real values
# DO NOT commit .env.staging (it is gitignored)

MYSQL_ROOT_PASSWORD=change_me_staging_root
MYSQL_DATABASE=project_alpha_staging
MYSQL_USER=appuser
MYSQL_PASSWORD=change_me_staging_app
ADMIN_PASSWORD=change_me_staging_admin
APP_ENCRYPTION_KEY=$(openssl rand -hex 32)
APP_AUTH_DISABLED=false

# Stripe TEST keys ONLY on staging (never live keys)
stripe_publishable_key=pk_test_your_publishable_key_here
stripe_secret_key_enc=plain::sk_test_your_secret_key_here
stripe_webhook_secret_enc=
