# Project Alpha — .env.example
#
# This file is for REFERENCE ONLY. You do NOT need to create a .env file.
# All configuration is done in docker-compose.yml.
#
# The ONLY reason to use a .env file is if you want to keep secrets
# out of your docker-compose.yml (e.g., for git-tracking the compose file).
# In that case, copy this to .env, fill in values, and docker-compose
# will read them automatically.

# Database (required if not set in docker-compose.yml)
MYSQL_DATABASE=project_alpha
MYSQL_USER=appuser
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme

# First-run admin password
ADMIN_PASSWORD=changeme

# Encryption key for UI-entered secrets (Stripe keys, SMTP, etc.)
# Generate: openssl rand -base64 32
# If not set, the container auto-generates one and persists it in config/
APP_ENCRYPTION_KEY=

# Stripe keys (OPTIONAL — enter via Settings > Billing UI instead)
# stripe_publishable_key=
# stripe_secret_key_enc=
# stripe_webhook_secret_enc=

# SMTP password (OPTIONAL — enter via Settings UI instead)
# smtp_password_enc=

# Backup encryption (OPTIONAL)
# BACKUP_ENCRYPTION_KEY=

# Dev only
APP_AUTH_DISABLED=***

# CORS
# ALLOWED_ORIGINS=https://your-domain.com