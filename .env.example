# Project Alpha Environment Configuration
# Copy this file to .env and fill in your secrets.
# NEVER commit .env to Git - it contains sensitive credentials.

# =============================================================================
# STRIPE CONFIGURATION
# =============================================================================
# Get these from https://dashboard.stripe.com/apikeys
# pk_test_... for testing, pk_live_... for production
stripe_publishable_key=""

# Secret key (starts with sk_test_ or sk_live_)
# This is encrypted before storage
stripe_secret_key_enc=""

# Webhook endpoint secret (starts with whsec_)
# Set this after creating a webhook endpoint in Stripe dashboard
stripe_webhook_secret_enc=""

# =============================================================================
# SMTP / EMAIL (Optional)
# =============================================================================
# For Gmail: use an App Password, not your normal password
# Generate one at: https://myaccount.google.com/apppasswords
smtp_password_enc=""

# =============================================================================
# ENCRYPTION KEY (Auto-generated if not set)
# =============================================================================
# 32-byte base64-encoded key used to encrypt secrets above (REQUIRED)
# Generate: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# The app will NOT auto-generate or persist this key - it must live in the environment.
APP_ENCRYPTION_KEY=""
