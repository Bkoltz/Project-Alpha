# Project Alpha Environment Configuration
# Copy this file to .env and fill in the required values.
# NEVER commit .env to Git - it contains sensitive credentials.
#
# STRIPE KEYS ARE OPTIONAL HERE — you can enter them via the
# Settings > Billing page in the app UI instead. They'll be
# encrypted and stored in the database.

# =============================================================================
# DATABASE / APP CREDENTIALS (required)
# =============================================================================
MYSQL_DATABASE="project_alpha"
MYSQL_USER="appuser"
MYSQL_PASSWORD="change_me_to_a_strong_password"
MYSQL_ROOT_PASSWORD="change_me_to_a_different_strong_password"

# First-run admin password (used to seed the initial admin account)
ADMIN_PASSWORD="change_me_admin_password"

# =============================================================================
# ENCRYPTION KEY (REQUIRED)
# =============================================================================
# 32-byte base64-encoded key used to encrypt secrets (Stripe keys, SMTP password)
# Generate: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Or: openssl rand -base64 32
# The app will NOT auto-generate or persist this key — it must live in the environment.
APP_ENCRYPTION_KEY=""

# =============================================================================
# STRIPE CONFIGURATION (OPTIONAL — can be set via Settings > Billing UI instead)
# =============================================================================
# If you set these here, they'll be used as defaults. Keys entered in the UI
# override these values. Leave blank to use UI-only configuration.
# stripe_publishable_key=""
# stripe_secret_key_enc=""
# stripe_webhook_secret_enc=""

# =============================================================================
# SMTP / EMAIL (OPTIONAL — can be set via Settings UI instead)
# =============================================================================
# smtp_password_enc=""

# =============================================================================
# BACKUP ENCRYPTION (OPTIONAL)
# =============================================================================
# If set, database backups will be encrypted with AES-256-GPG
# BACKUP_ENCRYPTION_KEY=""

# =============================================================================
# DEV / MISC (OPTIONAL)
# =============================================================================
# Dev convenience ONLY. Leave false (or unset) everywhere except local dev.
APP_AUTH_DISABLED="false"

# CORS origins allowed for API/settings endpoints (comma-separated list)
# ALLOWED_ORIGINS=https://pa.ledgetopdroneservices.com